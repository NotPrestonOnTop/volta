#!/bin/sh
# Take the app icons off the Home Screen when Volta is removed.
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    if command -v uicache >/dev/null 2>&1; then
        uicache -u /var/jb/Applications/VoltaPhone.app 2>/dev/null
        uicache -u /var/jb/Applications/VoltaCalc.app 2>/dev/null
        uicache -u /var/jb/Applications/Voltweaks.app 2>/dev/null
        for APP in VoltaWeather VoltaCompass VoltaMemos VoltaWallet VoltaSaved VoltaDrive; do
            uicache -u "/var/jb/Applications/$APP.app" 2>/dev/null
        done
    fi
fi
# If Volta's Safety page had iOS updates blocked, put them back the way Apple ships them:
# with Volta gone there would be no switch left to do it.
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    for CTL in /var/jb/usr/bin/launchctl /var/jb/bin/launchctl /bin/launchctl; do
        if [ -x "$CTL" ]; then
            for SERVICE in com.apple.mobile.softwareupdated com.apple.softwareupdateservicesd com.apple.OTATaskingAgent com.apple.mobile.NRDUpdated; do
                "$CTL" enable "system/$SERVICE" 2>/dev/null
            done
            break
        fi
    done
fi
exit 0
