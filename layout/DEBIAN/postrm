#!/bin/sh
# Take the app icons off the Home Screen when Volta is removed.
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    if command -v uicache >/dev/null 2>&1; then
        uicache -u /var/jb/Applications/VoltaPhone.app 2>/dev/null
        uicache -u /var/jb/Applications/VoltaCalc.app 2>/dev/null
        uicache -u /var/jb/Applications/Voltweaks.app 2>/dev/null
        for APP in VoltaWeather VoltaCompass VoltaMemos VoltaWallet; do
            uicache -u "/var/jb/Applications/$APP.app" 2>/dev/null
        done
    fi
fi
exit 0
